{
  "manifestVersion": 2,
  "id": "script-runner",
  "name": "Scripts",
  "version": "1.0.0",
  "description": "Run the scripts in a worktree's orca.yaml on demand, from a sidebar panel.",
  "author": {
    "name": "Elias Júnior"
  },
  "repository": "https://github.com/eliasjnior/orca-plugins",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "scripts",
        "title": "Scripts",
        "icon": "play",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "terminal:send"
    }
  ]
}
